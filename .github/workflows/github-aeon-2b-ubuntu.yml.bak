name: Aeon flow 2b ubuntu (aeon-brch-2)

on:
  workflow_dispatch: # manual trigger ability

env:
  OUT_FILE: aeon-out-part2.csv
  CATEGORIES_FILE: aeon-categories-2.txt

jobs:
  setup:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v6.0.2
        with:
          ref: aeon-branch-2 # Specify aeon-branch-2 directly for the primary checkout
          path: . # Checkout to the root of the runner's working directory    

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.13.13'
          cache: 'pip'
          cache-dependency-path: runner-src/requirements_b.txt

      - name: Check if recent file already exists
        id: freshness_check
        run: |
          git pull origin aeon-branch-2 --rebase

          FILE="raw_data/aeon-out-part2.csv"
          MAX_AGE=$((60 * 60))
          NOW=$(date +%s)

          LAST_COMMIT=$(git log -1 --format=%ct -- "$FILE")

          if [ -z "$LAST_COMMIT" ]; then
            echo "No previous file found, scraping needed."
            echo "skip=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          AGE=$((NOW - LAST_COMMIT))

          if [ "$AGE" -lt "$MAX_AGE" ]; then
            echo "File recently updated, no scraping needed."
            echo "skip=true" >> "$GITHUB_OUTPUT"
          else
            echo "File older than 60 minutes, scraping needed."
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Install system dependencies
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          sudo apt-get update
          sudo apt-get install -y p7zip-full xvfb

      - name: Start virtual display
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          export DISPLAY=:99
          Xvfb :99 -screen 0 1920x1080x24 &
          echo "Virtual display started"

      - name: Display system information
        run: |
          echo "Linux version:"
          uname -a
          echo "Python version:"
          python -V
          echo "IP address:"
          curl --no-progress-meter https://ipinfo.io/ip

      - name: Unzip .7z, copy categories and requirements
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          7z x runner-src/gather-aeon-src.7z -p${{ secrets.ZIP_PW }}
          cp runner-src/requirements* .
          cp runner-src/aeon-categories* .

      - name: pip install
        if: steps.freshness_check.outputs.skip != 'true'
        run: pip install -r requirements_b.txt

      - name: Run script and validate output. With retry, timeout.
        timeout-minutes: 43
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          check_output_file() {
            local file=$1
            local minsize=$2
            if [ ! -f "$file" ]; then
              echo "** Output file does not exist **"
              return 1
            fi
            filesize=$(stat -c%s "$file")
            if [ $filesize -lt $minsize ]; then
              echo "** Output file too small ($filesize bytes) **"
              return 1
            fi
            echo "Validation passed: output file seems OK."
            return 0
          }

          run_with_timeout() {
            local categories=$1
            local output=$2
            local timeoutMinutes=$3
            local attemptLabel=$4

            echo "=== $attemptLabel ==="
            timeout ${timeoutMinutes}m python -u aeon_cdp_args_040.py -c "$categories" -o "$output"
            check_output_file "$output" 5000
          }

          perAttemptTimeout=20

          if ! run_with_timeout "aeon-categories-2.txt" "aeon-out-part2.csv" $perAttemptTimeout "First attempt"; then
            echo "First attempt failed or timed out. Retrying after 45 seconds..."
            sleep 45
            if ! run_with_timeout "aeon-categories-2.txt" "aeon-out-part2.csv" $perAttemptTimeout "Second attempt"; then
              echo "** Retry failed. Aborting. **"
              exit 1
            fi
          fi

      - name: Set up Git
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"

      - name: Commit and push generated files
        if: steps.freshness_check.outputs.skip != 'true'
        run: |
          cp aeon-out-part2.csv raw_data/
          git add raw_data/aeon-out-part2.csv
          git commit -m "Automated: Add generated Aeon-2b file" || echo "No changes to commit"
          for i in 1 2 3; do
            git pull --rebase origin aeon-branch-2 && git push origin aeon-branch-2 && exit 0
            echo "Push attempt $i failed, retrying..."; sleep $((i * 5))
          done
          echo "** Push failed **"; exit 1
 